generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  password       String
  role           String   @default("user")
  phone          String?  @unique
  userType       UserType @default(ENTERPRISE)
  language       String   @default("en")
  organizationId String?
  assignedSites  Json?    // Array of site IDs
  preferences    Json?
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  detectionJobs     DetectionJob[]
  auditLogs         AuditLog[]
  detections        Detection[]
  quickChecks       QuickCheck[]
  stories           Story[]
  
  // ISO Audit relationships
  inspectorAudits   AuditRecord[]     @relation("InspectorAudits")
  managerAudits     AuditRecord[]     @relation("ManagerAudits")
  workflowEvents    WorkflowEvent[]   @relation("WorkflowEvents")
  workflowComments  WorkflowComment[] @relation("WorkflowComments")

  @@map("users")
}

model QuickCheck {
  id            String      @id @default(cuid())
  userId        String
  checkType     CheckType
  imageUrl      String
  score         Float
  status        String
  benchmark     Float?
  carbonSaved   Float?
  tips          String?
  createdAt     DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("quick_checks")
}

model Story {
  id          String   @id @default(cuid())
  userId      String
  imageUrl    String
  description String
  isAnonymous Boolean  @default(true)
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("stories")
}

model DetectionJob {
  id          String    @id @default(cuid())
  userId      String
  status      JobStatus @default(QUEUED)
  priority    Int       @default(0)
  config      Json
  progress    Float     @default(0)
  totalFiles  Int
  processedFiles Int    @default(0)
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  error       String?

  user    User           @relation(fields: [userId], references: [id])
  files   DetectionFile[]
  results DetectionResult[]

  @@map("detection_jobs")
}

model DetectionFile {
  id           String     @id @default(cuid())
  jobId        String
  originalName String
  filename     String
  filePath     String
  fileSize     Int
  mimeType     String
  status       FileStatus @default(PENDING)
  uploadedAt   DateTime   @default(now())
  processedAt  DateTime?

  job    DetectionJob      @relation(fields: [jobId], references: [id])
  result DetectionResult?

  @@map("detection_files")
}

model DetectionResult {
  id              String   @id @default(cuid())
  jobId           String
  fileId          String   @unique
  overallStatus   String
  processingTime  Float
  defectsFound    Int      @default(0)
  confidence      Float
  detections      Json
  createdAt       DateTime @default(now())

  job  DetectionJob  @relation(fields: [jobId], references: [id])
  file DetectionFile @relation(fields: [fileId], references: [id])

  @@map("detection_results")
}

model ModelInfo {
  id              String   @id @default(cuid())
  name            String   @unique
  version         String
  description     String?
  modelPath       String
  weightsPath     String?
  configPath      String
  inputSize       Json
  classNames      Json
  accuracy        Float?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("model_info")
}

model ComponentProfile {
  id                 String   @id @default(cuid())
  name               String   @unique
  materialType       String
  criticalDefects    Json
  defaultSensitivity Float    @default(0.7)
  qualityStandards   Json
  customParameters   Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("component_profiles")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Detection {
  id        String   @id @default(cuid())
  userId    String
  class     Int
  confidence Float
  bbox      Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("detections")
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum FileStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum UserType {
  ENTERPRISE
  WORKER
  BOSS
  INSPECTOR
  MANAGER
  ADMIN
}

enum CheckType {
  WELD
  ETCHING
}

// ISO Audit Dashboard Models
model Site {
  id             String   @id @default(cuid())
  name           String
  location       String
  organizationId String
  timezone       String   @default("UTC")
  contactInfo    Json?
  certifications Json?
  lastAuditDate  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  audits AuditRecord[]

  @@map("sites")
}

model AuditRecord {
  id            String      @id @default(cuid())
  siteId        String
  inspectorId   String
  managerId     String?
  auditDate     DateTime
  shift         AuditShift  @default(DAY)
  auditType     AuditType   @default(ROUTINE)
  pdcaStage     PDCAStage   @default(CHECK)
  status        AuditStatus @default(DRAFT)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  approvedAt    DateTime?
  complianceScore Float?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  site            Site              @relation(fields: [siteId], references: [id])
  inspector       User              @relation("InspectorAudits", fields: [inspectorId], references: [id])
  manager         User?             @relation("ManagerAudits", fields: [managerId], references: [id])
  responses       AuditResponse[]
  evidence        EvidenceRecord[]
  workflowHistory WorkflowEvent[]
  comments        WorkflowComment[]

  @@map("audit_records")
}

model AuditResponse {
  id               String       @id @default(cuid())
  auditId          String
  itemId           String
  isoClause        String
  questionText     String
  response         ResponseType
  numericValue     Float?
  textResponse     String?
  comments         String?
  severity         Severity?
  correctiveAction String?
  targetCloseDate  DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  audit    AuditRecord      @relation(fields: [auditId], references: [id])
  evidence EvidenceRecord[]

  @@map("audit_responses")
}

model EvidenceRecord {
  id           String      @id @default(cuid())
  auditId      String
  responseId   String?
  filename     String
  originalName String
  fileType     EvidenceType
  url          String
  thumbnailUrl String?
  fileSize     Int
  metadata     Json?
  uploadedAt   DateTime    @default(now())

  audit    AuditRecord    @relation(fields: [auditId], references: [id])
  response AuditResponse? @relation(fields: [responseId], references: [id])

  @@map("evidence_records")
}

model WorkflowEvent {
  id        String      @id @default(cuid())
  auditId   String
  userId    String
  eventType EventType
  fromStatus AuditStatus?
  toStatus   AuditStatus?
  details   Json?
  createdAt DateTime    @default(now())

  audit AuditRecord @relation(fields: [auditId], references: [id])
  user  User        @relation("WorkflowEvents", fields: [userId], references: [id])

  @@map("workflow_events")
}

model WorkflowComment {
  id        String      @id @default(cuid())
  auditId   String
  userId    String
  comment   String
  action    ActionType
  createdAt DateTime    @default(now())

  audit AuditRecord @relation(fields: [auditId], references: [id])
  user  User        @relation("WorkflowComments", fields: [userId], references: [id])

  @@map("workflow_comments")
}

model ISOChecklist {
  id          String             @id @default(cuid())
  version     String
  title       String
  description String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  sections ChecklistSection[]

  @@map("iso_checklists")
}

model ChecklistSection {
  id          String    @id @default(cuid())
  checklistId String
  title       String
  isoClause   String
  weight      Float     @default(1.0)
  order       Int
  createdAt   DateTime  @default(now())

  checklist ISOChecklist    @relation(fields: [checklistId], references: [id])
  items     ChecklistItem[]

  @@map("checklist_sections")
}

model ChecklistItem {
  id                        String   @id @default(cuid())
  sectionId                 String
  question                  String
  isoReference              String
  responseType              ResponseType @default(PASS_FAIL)
  required                  Boolean  @default(true)
  helpText                  String?
  correctiveActionTemplates Json?
  weight                    Float    @default(1.0)
  order                     Int
  createdAt                 DateTime @default(now())

  section ChecklistSection @relation(fields: [sectionId], references: [id])

  @@map("checklist_items")
}

enum AuditShift {
  DAY
  NIGHT
  WEEKEND
}

enum AuditType {
  ROUTINE
  INCIDENT
  FOLLOW_UP
}

enum PDCAStage {
  PLAN
  DO
  CHECK
  ACT
}

enum AuditStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum ResponseType {
  PASS_FAIL
  PASS_FAIL_NA
  NUMERIC
  TEXT
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EvidenceType {
  PHOTO
  VIDEO
  DOCUMENT
}

enum EventType {
  CREATED
  SUBMITTED
  ASSIGNED
  APPROVED
  REJECTED
  UPDATED
}

enum ActionType {
  SUBMIT
  APPROVE
  REJECT
  REQUEST_CHANGES
  COMMENT
}