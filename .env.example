# Database Connection (Supabase)
# DATABASE_URL: Transaction Pooler (Port 6543) - Use for application queries
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Session (Port 5432) - Use for migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
REDIS_URL="redis://localhost:6379"

# AWS ECS Backend (Production)
NEXT_PUBLIC_WELD_API_URL="http://23.22.163.148:10000"
NEXT_PUBLIC_PYTHON_API_URL="http://localhost:5000"

# ========================================
# Google OAuth2 Configuration
# ========================================

# NextAuth Secret (Generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-secret-key-here

# NextAuth URL (Change for production)
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Credentials (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ========================================
# Unified Detection Configuration
# ========================================

# Detection Mode: tfjs (client-side), backend (server API), or mock (testing)
NEXT_PUBLIC_DETECTION_MODE=tfjs

# TensorFlow.js Model URL (for client-side detection)
# Use relative path for Vercel deployment
NEXT_PUBLIC_TFJS_MODEL_URL=/models/yolo-defect-detector/tfjs_model/model.json

# External CDN URL (if model is hosted elsewhere to bypass Vercel file size limits)
# NEXT_PUBLIC_TFJS_MODEL_URL=https://storage.googleapis.com/your-bucket/model.json

# Backend Detection API URL (for backend mode)
NEXT_PUBLIC_BACKEND_DETECTION_URL=/api/detect-lambda

# ========================================
# AWS Lambda Backend Configuration
# ========================================

# Server-Side Model URL (for AWS Lambda backend)
# Option 1: Load from S3 (Recommended for production)
MODEL_URL=https://your-s3-bucket.s3.amazonaws.com/yolo-defect-detector/tfjs_model/model.json

# Option 2: Load from bundled model (slower, larger deployment)
# MODEL_URL=/models/yolo-defect-detector/tfjs_model/model.json

# Lambda Configuration (optional - set in Amplify Console)
# AWS_LAMBDA_FUNCTION_MEMORY_SIZE=3008
# AWS_LAMBDA_FUNCTION_TIMEOUT=300

# Analytics (optional)
NEXT_PUBLIC_ENABLE_ANALYTICS=false
